# Supabase project (Settings > API). The anon key is safe in the browser only because Row Level Security is on:
# run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Lets /api/agency/bookings read a partner's bookings. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Paid AI keys for the ad-copy assistant (admin picks the provider at /admin/settings/ai). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Invitation cards: WhatsApp delivery (server-only, never NEXT_PUBLIC_). Dispatch uses n8n when N8N_WAAU_WEBHOOK_URL is set,
# otherwise the direct Waau Panel API below; with neither, cards are stored and left "queued".
# n8n webhook that receives { eventTitle, senderName, supabaseCallbackUrl, items: [{ id, guestName, guestPlace, guestPhone, message, cardUrl }] }.
N8N_WAAU_WEBHOOK_URL=
# Shared secret. Sent to n8n as the x-webhook-secret header, and required from n8n on POST /api/invitations/waau-status
# (that endpoint also accepts "Authorization: Bearer <SUPABASE_SERVICE_ROLE_KEY>").
N8N_WEBHOOK_SECRET=
# Direct Waau Panel API (used when n8n is not configured, or as a fallback if the n8n call fails).
WAAU_API_URL=
WAAU_API_KEY=
# Public https URL of this site, used to build the status callback URL given to n8n (falls back to the request host).
NEXT_PUBLIC_SITE_URL=
# Optional: dispatch requests allowed per user per 10 minutes (default 250, or 2500 when n8n is configured).
INVITATION_DISPATCH_RATE_LIMIT=
