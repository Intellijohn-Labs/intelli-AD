# Supabase project (Settings > API). The anon key is safe in the browser only because Row Level Security is on:
# run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Lets /api/agency/bookings read a partner's bookings. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Paid AI keys for the ad-copy assistant (admin picks the provider at /admin/settings/ai). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
